# Copy to .env and fill in. See README for where each value comes from.

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=

# Postgres: pooled connection for the app, direct connection for migrations
DATABASE_URL=
DIRECT_URL=

# Google OAuth (redirect URI: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth.js session secret: generate with `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=

# Tests only: a throwaway Postgres that `npm test` may wipe. When unset, the
# tests start their own embedded Postgres. Never point this at DATABASE_URL.
# TEST_DATABASE_URL=

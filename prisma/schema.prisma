// Prisma 7: the connection URL lives in prisma.config.ts (CLI) and in the
// driver adapter (runtime), not in this file.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js tables, as documented for @auth/prisma-adapter (database sessions).
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  /// Null until onboarding completes. That null is what routes a first-time
  /// user to onboarding.
  favoriteMovie String?

  /// After a failed generation, no new OpenAI call is made for this user
  /// before this time. Written by the app clock. See src/lib/facts/timings.ts.
  factRetryAfter DateTime?

  accounts  Account[]
  sessions  Session[]
  facts     Fact[]
  factLease FactLease?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// App tables
// ---------------------------------------------------------------------------

model Fact {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The title this fact was generated for. A snapshot, so the fact stays
  /// truthful even if the user's favorite movie changes later.
  movie String
  text  String
  /// Which OpenAI model wrote it, for debugging and auditing.
  model String

  /// Written by the app clock (not a DB default) so that writing and
  /// freshness checks use the same clock.
  createdAt DateTime

  // Serves "latest fact for this user and movie".
  @@index([userId, movie, createdAt(sort: Desc)])
}

/// Burst guard: at most one row per user. Whoever holds the row is the only
/// request allowed to call OpenAI for that user. See src/lib/facts/lease.ts.
model FactLease {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Random per holder, so a holder can only release its own lease.
  token     String
  expiresAt DateTime
}
